{
  "id": "defnojae1337x",
  "name": "EXT Torrents",
  "version": "2.1.1",
  "description": "EXT.to anime torrents: sub, dub, dual audio, episodes and batches. Replaces the former 1337x provider.",
  "author": "DefnoJae",
  "type": "anime-torrent-provider",
  "language": "javascript",
  "lang": "multi",
  "manifestURI": "https://raw.githubusercontent.com/DefnoJae/1337X/main/Manifest.json",
  "payloadURI": "https://raw.githubusercontent.com/DefnoJae/1337X/main/provider.js",
  "icon": "https://raw.githubusercontent.com/DefnoJae/1337X/main/assets/logo.png",
  "website": "https://ext.to",
  "readme": "https://github.com/DefnoJae/1337X#readme",
  "userConfig": {
    "version": 3,
    "requiresConfig": false,
    "fields": [
      {
        "name": "browserMode",
        "label": "Browser fallback mode",
        "type": "select",
        "default": "visible",
        "options": [
          {
            "value": "visible",
            "label": "Visible browser (complete verification if prompted)"
          },
          {
            "value": "headless",
            "label": "Headless browser (servers without a display)"
          },
          {
            "value": "cloak",
            "label": "Local CloakBrowser helper"
          }
        ]
      },
      {
        "name": "browserTimeout",
        "label": "Browser timeout in seconds (30–120)",
        "type": "text",
        "default": "60"
      },
      {
        "name": "helperToken",
        "label": "Local helper token (from .ext-helper/connection.json)",
        "type": "text",
        "default": ""
      }
    ]
  }
}
